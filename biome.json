{
  "$schema": "https://biomejs.dev/schemas/2.4.12/schema.json",
  "files": {
    "includes": [
      "packages/**",
      "!**/node_modules/**",
      "!**/dist/**",
      "!**/coverage/**",
      "!**/docs/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "useIterableCallbackReturn": "off",
        "noImplicitAnyLet": "off"
      }
    }
  }
}
