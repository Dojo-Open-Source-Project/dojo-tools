{
  "name": "dojo-tools",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for Dojo JS/TS tools",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.0.0 <12.0.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "lint": "pnpm -r --if-present run lint",
    "check": "pnpm -r --if-present run check",
    "typecheck": "pnpm -r --if-present run typescript",
    "clean": "pnpm -r --if-present run build:clean"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/node": "^24.13.2",
    "@vitest/coverage-v8": "^4.1.9",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
