{
  "name": "dojo-tools",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for Dojo JS/TS tools",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "lint": "pnpm -r --if-present run lint",
    "check": "pnpm -r --if-present run check",
    "typecheck": "pnpm -r --if-present run typescript",
    "clean": "pnpm -r --if-present run build:clean"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^24.12.2",
    "@vitest/coverage-v8": "^4.1.6",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
