{
  "name": "dojo-tools",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for Dojo JS/TS tools",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.0.0 <12.0.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "lint": "pnpm -r --if-present run lint",
    "check": "pnpm -r --if-present run check",
    "typecheck": "pnpm -r --if-present run typescript",
    "clean": "pnpm -r --if-present run build:clean"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
