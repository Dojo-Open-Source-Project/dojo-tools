{
  "name": "@dojo-tools/auth47",
  "version": "1.2.1",
  "description": "A JS implementation of the Auth47 protocol",
  "keywords": [
    "bitcoin",
    "bip47",
    "bip-47",
    "auth47",
    "auth-47",
    "paynym"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.x.x"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest watch",
    "coverage": "vitest run --coverage",
    "typescript": "tsc --noEmit",
    "lint": "pnpm exec biome lint src test",
    "build:clean": "rm -rf dist",
    "build:esm": "pnpm exec esbuild \"src/**/*.ts\" --format=esm --platform=node --target=es2020 --sourcemap --outdir=dist",
    "build": "pnpm run build:clean && pnpm run build:esm && pnpm run build:types",
    "prepack": "pnpm run lint && pnpm run typescript && pnpm run test && pnpm run build",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly --rootDir src --outDir dist --paths null",
    "lint:fix": "pnpm exec biome lint --write src test",
    "format": "pnpm exec biome format --write src test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Dojo-Open-Source-Project/auth47.git"
  },
  "bugs": {
    "url": "https://github.com/Dojo-Open-Source-Project/auth47/issues"
  },
  "author": "Katana Cryptographic Ltd.",
  "license": "LGPL-3.0",
  "homepage": "https://github.com/Dojo-Open-Source-Project/auth47",
  "dependencies": {
    "@dojo-tools/bip47": "workspace:*",
    "@dojo-tools/bitcoinjs-message": "workspace:*"
  },
  "devDependencies": {
    "tiny-secp256k1": "catalog:"
  }
}
