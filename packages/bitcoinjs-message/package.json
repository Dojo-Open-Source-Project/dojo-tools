{
  "name": "@dojo-tools/bitcoinjs-message",
  "version": "3.1.1",
  "description": "bitcoinjs-message",
  "keywords": [
    "bitcoinjs-message",
    "bitcoin"
  ],
  "homepage": "https://github.com/Dojo-Open-Source-Project/bitcoinjs-message",
  "bugs": {
    "url": "https://github.com/Dojo-Open-Source-Project/bitcoinjs-message/issues"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/Dojo-Open-Source-Project/bitcoinjs-message.git"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "typescript": "tsc --noEmit",
    "lint": "pnpm exec biome lint src test",
    "lint:fix": "pnpm exec biome lint --write src test",
    "build:clean": "rm -rf dist",
    "build:esm": "pnpm exec esbuild $(find src -name '*.ts' | sort) --format=esm --platform=node --target=es2020 --sourcemap --outdir=dist",
    "build": "pnpm run build:clean && pnpm run build:esm && pnpm run build:types",
    "prepack": "pnpm run lint && pnpm run typescript && pnpm run test && pnpm run build",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly --rootDir src --outDir dist --paths null",
    "format": "pnpm exec biome format --write src test"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@scure/base": "^2.0.0",
    "varuint-bitcoin": "^2.0.0"
  },
  "devDependencies": {
    "bitcoinjs-lib": "^7.0.1",
    "ecpair": "^3.0.0",
    "tiny-secp256k1": "^2.2.3"
  },
  "engines": {
    "node": ">=16.6.0"
  }
}
