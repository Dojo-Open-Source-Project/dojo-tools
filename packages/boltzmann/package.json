{
  "name": "@dojo-tools/boltzmann",
  "version": "1.0.0",
  "author": "Katana Cryptographic Ltd.",
  "license": "LGPL-3.0",
  "homepage": "https://github.com/Dojo-Open-Source-Project/dojo-tools",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "import": "./dist/boltzmann.js",
      "types": "./dist/boltzmann.d.ts"
    }
  },
  "types": "./dist/boltzmann.d.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest watch",
    "lint": "pnpm exec biome lint src test",
    "lint:fix": "pnpm exec biome lint --write src test",
    "pretty": "pnpm exec biome format --write src test",
    "check": "pnpm exec biome check --write src test",
    "typescript": "tsc --noEmit",
    "build:clean": "rm -rf ./dist",
    "build:esm": "pnpm exec esbuild \"src/**/*.ts\" --format=esm --platform=node --target=es2022 --sourcemap --outdir=dist",
    "build": "pnpm run build:clean && pnpm run build:esm && pnpm run build:types",
    "prepack": "pnpm install && pnpm run lint && pnpm run typescript && pnpm run test && pnpm run build",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly --rootDir src --outDir dist --paths null"
  },
  "devDependencies": {
    "@types/big.js": "^6.2.2"
  },
  "dependencies": {
    "big.js": "^7.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dojo-Open-Source-Project/dojo-tools.git"
  },
  "bugs": {
    "url": "https://github.com/Dojo-Open-Source-Project/dojo-tools/issues"
  }
}
