{
  "name": "@dojo-tools/next-block-estimator-cli",
  "version": "1.0.0",
  "engines": {
    "node": ">=24"
  },
  "description": "A CLI tool estimating the minimum feerate required for the inclusion of a bitcoin transaction into the next block.",
  "keywords": [
    "bitcoin",
    "fees",
    "calculator",
    "estimator",
    "cli"
  ],
  "type": "module",
  "bin": {
    "next-block-estimator": "dist/bin.js"
  },
  "scripts": {
    "typescript": "tsc --noEmit",
    "build:clean": "rm -rf dist",
    "build:esm": "pnpm exec esbuild \"src/**/*.ts\" --format=esm --platform=node --target=es2020 --sourcemap --outdir=dist",
    "build": "pnpm run build:clean && pnpm run build:esm && chmod +x ./dist/bin.js",
    "prepack": "pnpm install && pnpm -w run lint && pnpm run typescript && pnpm run build",
    "lint": "pnpm exec biome lint src",
    "lint:fix": "pnpm exec biome lint --write src",
    "format": "pnpm exec biome format --write src",
    "check": "pnpm exec biome check --write src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dojo-Open-Source-Project/dojo-tools.git"
  },
  "bugs": {
    "url": "https://github.com/Dojo-Open-Source-Project/dojo-tools/issues"
  },
  "author": "Katana Cryptographic Ltd.",
  "license": "LGPL-3.0",
  "homepage": "https://github.com/Dojo-Open-Source-Project/dojo-tools",
  "dependencies": {
    "@dojo-tools/next-block-estimator": "workspace:*"
  }
}
